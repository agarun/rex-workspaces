{
  "$schema": "https://raw.githubusercontent.com/agarun/rex-workspaces/main/schema.json",
  "workspaces": {
    "my-project": {
      "root": "~/.config/rex/rex-workspaces/examples/my-project",
      "key": "ctrl+cmd+1",
      "focus": "agents",
      "switch": true,
      "servers_in": "float",
      "stop_timeout": 5,
      "stop": { "servers": "close", "panes": "interrupt" },
      "servers": [
        { "label": "api", "cwd": "api", "cmd": "make dev", "minimized": true },
        { "label": "web", "cwd": "web", "cmd": "npm run dev", "minimized": false, "bounds": [0.6, 0.05, 0.38, 0.3] }
      ],
      "tabs": [
        {
          "name": "agents",
          "split": "grid",
          "panes": [
            { "label": "api", "cwd": "api" },
            { "label": "web", "cwd": "web" },
            { "label": "api tests", "cwd": "api" },
            { "label": "shell", "stop": "leave" }
          ]
        },
        {
          "name": "checks",
          "split": "right",
          "panes": [
            { "label": "tests", "cwd": "api", "cmd": "make test" },
            {
              "split": "down",
              "panes": [
                { "label": "files", "cmd": "ls" },
                { "label": "web", "cwd": "web" }
              ]
            }
          ]
        }
      ],
      "hooks": {
        "before_start": "date > .last-start",
        "after_start": "echo started >> .history",
        "before_stop": "echo stopping >> .history",
        "after_stop": "date > .last-stop"
      }
    }
  }
}
